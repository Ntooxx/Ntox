{
  "name": "ntox",
  "version": "0.1.0",
  "description": "Cognitive CLI agent with persistent memory, multi-channel gateway, and Docker sandboxing",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cognition": {
      "types": "./dist/cognition/index.d.ts",
      "import": "./dist/cognition/index.js"
    },
    "./alive": {
      "types": "./dist/alive/index.d.ts",
      "import": "./dist/alive/index.js"
    },
    "./alive/ntox": {
      "types": "./dist/alive/ntox.d.ts",
      "import": "./dist/alive/ntox.js"
    },
    "./alive/host": {
      "types": "./dist/alive/host.d.ts",
      "import": "./dist/alive/host.js"
    }
  },
  "bin": {
    "ntox": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "marketplace/",
    "web/",
    "LICENSE",
    "README.md",
    "HIGHLIGHTS.md",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "gateway": "tsx src/index.ts gateway",
    "gateway:watch": "tsx watch src/index.ts gateway",
    "gateway:build": "node dist/index.js gateway",
    "gateway:discord": "tsx src/index.ts gateway discord",
    "api": "tsx src/index.ts api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/ desktop/ integrations/deepseek-harness/src harness/ntox-harness/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --testTimeout=20000",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify:all": "node scripts/verify-all.mjs",
    "size:budget": "node scripts/size-budget.mjs",
    "check:trust-anchor": "node scripts/check-trust-anchor.mjs",
    "review": "node scripts/review/index.mjs",
    "bench:startup": "npm run build && node scripts/bench-startup.mjs",
    "bench:cognitive": "npm run build && node dist/benchmark/run-ci.js",
    "bench:alive": "npm run build && node scripts/bench-alive.mjs",
    "bench:m5": "npm run build && node scripts/m5-run.mjs",
    "bench:meta": "npm run build && node scripts/bench-meta.mjs",
    "eval:necessity": "npm run build && node scripts/bench-meta.mjs --necessity",
    "eval:offline-recall": "npm run build && node scripts/measure-offline-recall.mjs --all",
    "eval:injection": "npm run build && node scripts/measure-injection.mjs --layer=full",
    "eval:skill-author": "npm run build && node scripts/measure-skill-author.mjs",
    "eval:longitudinal": "npm run build && node scripts/bench-meta.mjs --longitudinal",
    "eval:scorecard": "npm run build && node scripts/experiments/scorecard/run.mjs",
    "eval:routing": "npm run build && node scripts/bench-routing.mjs",
    "eval:cognitive-gain": "npm run build && node scripts/bench-cognitive-gain.mjs",
    "e2e:live": "npm run build && node scripts/e2e-live.mjs --all",
    "scorecard": "node scripts/verify-scorecard.mjs",
    "prepublishOnly": "npm run build",
    "harness:build": "npm run build && npm run build --prefix harness/ntox-harness",
    "harness:test": "npm run harness:build && npm run test --prefix harness/ntox-harness",
    "harness:cli": "node harness/ntox-harness/dist/cli.js",
    "eval:dsh-proof": "npm run build --prefix integrations/deepseek-harness && node integrations/deepseek-harness/scripts/run-proof.mjs",
    "eval:dsh-proof-local": "npm run build --prefix integrations/deepseek-harness && node integrations/deepseek-harness/scripts/run-local-proof.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "cognitive",
    "llm",
    "personal-assistant",
    "pattern-compilation",
    "telegram",
    "discord",
    "docker",
    "sandbox"
  ],
  "author": "Anton Pupkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ntooxx/Ntox.git"
  },
  "bugs": {
    "url": "https://github.com/Ntooxx/Ntox/issues"
  },
  "homepage": "https://github.com/Ntooxx/Ntox#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "chalk": "^5.4.1",
    "gpt-tokenizer": "^3.4.0",
    "linkedom": "^0.18.13",
    "ora": "^8.1.1",
    "puppeteer-core": "^25.16.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.1",
    "zod": "^3.24.3"
  },
  "optionalDependencies": {
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "types": "./dist/index.d.ts"
}
